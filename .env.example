# ---------------------------------------------------------------------------
# Blade Fruit game service — copy to .env and fill in. Never commit .env.
# Secrets marked (secret) must be ≥ 32 random bytes, e.g.:  openssl rand -hex 32
# The service refuses to start if a required secret is missing or still "change-me".
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Set to the number of proxy hops (e.g. 1) when behind a load balancer, so rate limits see real client IPs
TRUST_PROXY=0
LOG_LEVEL=info

# --- Admin panel (fixed credentials) ---
ADMIN_USERNAME=admin
# Plaintext, or a bcrypt hash starting with $2
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me                 # (secret) signs admin session cookie
ADMIN_SESSION_TTL_HOURS=8

# --- Player identity ---
HOST_SHARED_SECRET=change-me               # (secret) host signs player tokens (HS256) with this
PLAYER_JWT_SECRET=change-me                # (secret) signs short-lived player session tokens
# Initial value only; editable later in admin Gameplay settings
GUEST_PLAY_ENABLED=true

# --- Storage ---
DATABASE_PATH=./data/blade-fruit.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=1048576
EVENT_RETENTION_DAYS=90

# --- Webhooks ---
DATA_ENCRYPTION_KEY=change-me              # (secret) 32-byte hex; encrypts webhook secrets at rest
WEBHOOK_ALLOW_PRIVATE=false                # true only in development (allows http/localhost targets)

# --- Embedding / CORS ---
# Space-separated origins allowed to iframe /play
ALLOWED_FRAME_ANCESTORS=http://localhost:3000
# Comma-separated origins allowed to call integration API from a browser (prefer server-to-server)
CORS_ORIGINS=
